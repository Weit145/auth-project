@startuml
!pragma layout smetana
title KLoad — обзор хранилищ и данных
left to right direction
skinparam shadowing false

package "PostgreSQL (auth)" {
  entity "users" as users {
    * id : UUID <<PK>>
    --
    email : TEXT <<UNIQUE>>
    password_hash : TEXT?
    role : TEXT
    email_verified_at : TIMESTAMPTZ?
  }
  entity "email_verification_tokens" as email_tokens {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    token_hash : TEXT <<UNIQUE>>
  }
  entity "registration_sessions" as registration {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    token_hash : TEXT <<UNIQUE>>
  }
  entity "refresh_sessions" as refresh {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    refresh_token_hash : TEXT <<UNIQUE>>
  }
  entity "password_reset_tokens" as password {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    token_hash : TEXT <<UNIQUE>>
  }
  entity "event_outbox" as outbox {
    * id : SERIAL <<PK>>
    --
    event_id : UUID <<UNIQUE>>
    user_id : UUID
    status : VARCHAR(50)
  }
}
package "SQLite (notification worker)" {
  entity "email_send_idempotency" as idem {
    * idempotency_key : TEXT <<PK>>
    --
    status : TEXT
    updated_at : REAL
  }
}
entity "Redis keyspace (gateway)" as redis_store {
  rate_limit:ip:<ip>
  rate_limit:user:id:<uuid>
  rate_limit:email:<masked-email>
}

users ||--o{ email_tokens
users ||--o{ registration
users ||--o{ refresh
users ||--o{ password
users ..> outbox : user_id, без FK в SQL
outbox ..> idem : event_id / ключ идемпотентности

note bottom of outbox
  Полная схема PostgreSQL: auth-startup/docs/database.puml
  Ключи Redis: gateway-startup/docs/database.puml
end note
@enduml
